        "jsCode": "const cb = $json.callback_query;\nconst data = cb.data || '';\nconst parts = data.split('_');\nconst action = parts[0];\nconst rowId = parts.slice(1).join('_');\nreturn [{ json: {\n  action,\n  rowId,\n  messageId: cb.message.message_id,\n  chatId: cb.message.chat.id,\n  callbackQueryId: cb.id,\n} }];\n"
